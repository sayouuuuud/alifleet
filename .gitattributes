# نهايات السطور — مهم جدًا للملفات اللي بتتنفّذ على السيرفر
#
# ويندوز بيحوّل نهايات السطور لـ CRLF (\r\n) عند الـ checkout. لينكس بيعتبر الـ \r
# جزء من الأمر نفسه، فبيفشل بـ:  $'\r': command not found
#
# السطور اللي تحت بتفرض LF على أي ملف بيتنفّذ على السيرفر، بغض النظر عن نظام الجهاز.

* text=auto eol=lf

# سكربتات وملفات إعداد السيرفر — LF إلزامي
*.sh            text eol=lf
*.sudoers       text eol=lf
*.conf          text eol=lf
*.service       text eol=lf
*.mjs           text eol=lf
*.php           text eol=lf

# ملفات ويندوز — تفضل CRLF
*.bat           text eol=crlf
*.cmd           text eol=crlf
*.ps1           text eol=crlf

# ملفات ثنائية — متتلمسش
*.png           binary
*.jpg           binary
*.jpeg          binary
*.gif           binary
*.webp          binary
*.ico           binary
*.woff          binary
*.woff2         binary
*.ttf           binary
*.zip           binary
*.gz            binary
*.pdf           binary
